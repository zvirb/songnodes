    "aggregate_id": { "type": "string" },
    "event_type": { "type": "string", "const": "library.set.saved.v1" },
    "payload": {
      "type": "object",
      "properties": {
        "set_name": { "type": "string" },
        "track_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "saved_at": { "type": "string", "format": "date-time" }
      },
      "required": ["set_name", "track_ids"]
    }
  },
  "required": ["aggregate_type", "aggregate_id", "event_type", "payload"]
}
